# Plan B: servir el frontend con nginx (por ejemplo, como Web Service Docker en Render).
# nginx reemplaza ${API_URL} al arrancar con el valor de la variable de entorno (sin barra final).
server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Igual que el proxy de Vite en desarrollo: /api va al backend y el navegador ve un solo origen,
    # así la cookie de sesión HttpOnly y el token CSRF funcionan sin CORS.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
    }

    # Archivos con hash en el nombre: se pueden guardar en caché mucho tiempo
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Rutas de React Router: cualquier otra ruta entrega index.html
    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        try_files $uri /index.html;
    }
}
